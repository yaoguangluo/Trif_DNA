        	    //section - loop
                for(int i = 0; i + log < size; i = i + log) {                 			  
                	Ei = fxet[i + j] * detaT;
                  	fxet[i + j] += Ei;	
                  	fxet[i + j + logd] -= Ei;	
       		    }
            }
        	log = logi;
        }
        for(int i = 0; i < fxet.length; i++) {
        	fxet[i] = Math.abs(fxet[i]);
        }
        return fxet;
	}


